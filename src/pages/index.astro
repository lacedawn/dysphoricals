---
import '../styles/global.css';
import Window from '../components/Window.astro';

const LASTFM_API_KEY = import.meta.env.PUBLIC_LASTFM_API_KEY || '';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/dysphoricals/favicon.svg" />
		<title>dysphoricals</title>
	</head>
	<body>
		<div id="bg-layer">
			<img src="/dysphoricals/bg.webp" alt="" />
		</div>
		<div id="page-content">
			<div class="desktop-layout">
				<div class="window-wrapper window-about">
					<Window title="about.info" icon="♡">
						<div class="content-block">
							<p>hi! im lena. im a 17 years old high school student from iraq</p>
							<p>read my <a href="/dysphoricals/journal" class="journal-link">journal</a></p>
						</div>
					</Window>
				</div>
				
				<div class="window-wrapper window-links">
					<Window title="socials.url" icon="✧">
						<div class="content-block links-list">
							<div class="links-column">
								<a href="https://github.com/lacedawn" target="_blank" rel="noopener noreferrer">github</a>
								<a href="https://x.com/lacedawnn" target="_blank" rel="noopener noreferrer">twitter</a>
								<a href="https://letterboxd.com/lacedawn/" target="_blank" rel="noopener noreferrer">letterboxd</a>
								<a href="https://www.last.fm/user/Leno727" target="_blank" rel="noopener noreferrer">last.fm</a>
							</div>
							<div class="links-column">
								<a href="https://www.instagram.com/0lacedawn/" target="_blank" rel="noopener noreferrer">instagram</a>
								<a href="https://www.reddit.com/user/Puzzleheaded-Taro492/" target="_blank" rel="noopener noreferrer">reddit</a>
								<a href="mailto:lacedawnn@gmail.com">email</a>
								<button class="discord-copy" onclick="navigator.clipboard.writeText('giwtwm'); this.textContent = 'copied!'; setTimeout(() => this.textContent = 'discord', 1000)">discord</button>
							</div>
						</div>
					</Window>
				</div>

				<div class="window-wrapper window-music">
					<Window title="lastlistened.ogg" icon="♫">
						<div class="content-block" id="lastfm-content">
							<p class="loading">loading...</p>
						</div>
					</Window>
				</div>

				<div class="window-wrapper window-watch">
					<Window title="lastwatched.mkv" icon="▶">
						<div class="content-block" id="letterboxd-content">
							<p class="loading">loading...</p>
						</div>
					</Window>
				</div>
			</div>
		</div>

		<script define:vars={{ LASTFM_API_KEY }}>
			async function fetchLastfm() {
				try {
					const USER = 'Leno727';
					const ENDPOINT = `https://ws.audioscrobbler.com/2.0/?method=user.getrecenttracks&user=${USER}&api_key=${LASTFM_API_KEY}&format=json&limit=1`;
					
					const res = await fetch(ENDPOINT);
					if (!res.ok) throw new Error('Last.fm fetch failed');
					
					const data = await res.json();
					const track = data.recenttracks.track[0];
					
					const container = document.getElementById('lastfm-content');
					container.innerHTML = `
						<a href="${track.url}" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 16px; text-decoration: none; color: #e8dff0;">
							<img src="${track.image.find(i => i.size === 'extralarge')?.['#text'] || track.image[track.image.length - 1]['#text']}" 
								alt="Album Art" 
								style="width: 160px; height: 160px; min-width: 160px; max-width: 160px; flex-shrink: 0; border-radius: 6px; object-fit: cover; border: 1px solid rgba(184, 160, 232, 0.4);" />
							<div style="display: flex; flex-direction: column; gap: 4px;">
								<div style="font-weight: 600; font-size: 0.95rem;">${track.name}</div>
								<div style="font-size: 0.8rem; color: #c4b8d8;">${track.artist['#text']}</div>
							</div>
						</a>
					`;
				} catch (err) {
					console.error('Last.fm error:', err);
					document.getElementById('lastfm-content').innerHTML = '<p class="error">failed to load</p>';
				}
			}

			async function fetchLetterboxd() {
				try {
					const USER = 'lacedawn';
					const RSS_URL = `https://letterboxd.com/${USER}/rss/`;
					
					const CORS_PROXY = 'https://corsproxy.io/?';
					const res = await fetch(CORS_PROXY + encodeURIComponent(RSS_URL));
					if (!res.ok) throw new Error('Letterboxd fetch failed');
					
					const xml = await res.text();
					const parser = new DOMParser();
					const xmlDoc = parser.parseFromString(xml, 'text/xml');
					
					const item = xmlDoc.querySelector('item');
					if (!item) throw new Error('No items found');
					
					const title = item.querySelector('letterboxd\\:filmTitle, filmTitle')?.textContent || '';
					const year = item.querySelector('letterboxd\\:filmYear, filmYear')?.textContent || '';
					const url = item.querySelector('link')?.textContent || '';
					
					const description = item.querySelector('description')?.textContent || '';
					const imgMatch = description.match(/<img src="([^"]+)"/);
					const image = imgMatch ? imgMatch[1] : '';
					
					let director = '';
					if (url) {
						const baseFilmUrl = url.replace(`/${USER}`, '');
						try {
							const filmRes = await fetch(CORS_PROXY + encodeURIComponent(baseFilmUrl));
							if (filmRes.ok) {
								const filmHtml = await filmRes.text();
								const dirMatch = filmHtml.match(/<meta name="twitter:data1" content="([^"]+)"/);
								if (dirMatch) director = dirMatch[1];
							}
						} catch (e) {
						}
					}
					
					const container = document.getElementById('letterboxd-content');
					container.innerHTML = `
						<a href="${url}" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 16px; text-decoration: none; color: #e8dff0;">
							<img src="${image}" 
								alt="${title}" 
								style="width: 110px; height: 165px; min-width: 110px; max-width: 110px; flex-shrink: 0; border-radius: 6px; object-fit: cover; border: 1px solid rgba(184, 160, 232, 0.4);" />
							<div style="display: flex; flex-direction: column; gap: 4px;">
								<div style="font-weight: 600; font-size: 0.95rem; line-height: 1.3;">${title} <span style="font-weight: 400; font-size: 0.85rem; color: #c4b8d8;">(${year})</span></div>
								${director ? `<div style="font-size: 0.8rem; color: #c4b8d8;">directed by ${director}</div>` : ''}
							</div>
						</a>
					`;
				} catch (err) {
					console.error('Letterboxd error:', err);
					document.getElementById('letterboxd-content').innerHTML = '<p class="error">failed to load</p>';
				}
			}

			fetchLastfm();
			fetchLetterboxd();
		</script>
	</body>
</html>

<style>
	.desktop-layout {
		display: grid;
		grid-template-columns: repeat(12, 1fr);
		grid-template-rows: auto auto auto;
		gap: 24px;
		padding: 48px;
		max-width: 1400px;
		margin: 0 auto;
		min-height: 100vh;
		align-items: start;
	}

	.window-about {
		grid-column: 2 / 7;
		grid-row: 1;
		margin-top: 20px;
	}

	.window-links {
		grid-column: 8 / 11;
		grid-row: 1;
		margin-top: 60px;
	}

	.window-music {
		grid-column: 2 / 6;
		grid-row: 2;
		margin-top: -30px;
	}

	.window-watch {
		grid-column: 8 / 12;
		grid-row: 2;
		margin-top: 40px;
	}

	.content-block {
		line-height: 1.6;
		font-size: 0.9rem;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
	}

	.loading, .error {
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.links-list {
		display: flex;
		gap: 24px;
	}

	.links-column {
		display: flex;
		flex-direction: column;
		gap: 12px;
		flex: 1;
	}

	.links-list a {
		color: var(--text);
		text-decoration: none;
		display: inline-block;
	}

	.links-list a::before {
		content: "↗ ";
		color: var(--accent-lavender);
		opacity: 0.8;
	}

	.discord-copy {
		background: none;
		border: none;
		color: var(--text);
		font-family: 'JetBrains Mono', monospace;
		font-size: inherit;
		padding: 0;
		cursor: pointer;
		text-align: left;
		display: inline-block;
	}

	.discord-copy::before {
		content: "↗ ";
		color: var(--accent-lavender);
		opacity: 0.8;
	}

	.discord-copy:hover {
		color: var(--text);
	}

	.journal-link {
		color: var(--accent-lavender);
		text-decoration: none;
	}

	@media (max-width: 900px) {
		.desktop-layout {
			display: flex;
			flex-direction: column;
			padding: 24px;
			gap: 24px;
		}

		.window-about, .window-links, .window-music, .window-watch {
			margin-top: 0;
			grid-column: auto;
			grid-row: auto;
			width: 100%;
		}
	}
</style>

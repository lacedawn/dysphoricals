---
import '../styles/global.css';
import Window from '../components/Window.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('journal');
const sortedEntries = entries.sort((a, b) => {
  if (a.data.pinned && !b.data.pinned) return -1;
  if (!a.data.pinned && b.data.pinned) return 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/dysphoricals/favicon.svg" />
		<title>journal</title>
	</head>
	<body>
		<div id="bg-layer">
			<img src="/dysphoricals/bg.webp" alt="" />
		</div>
		<div id="page-content">
			<div class="journal-container">
				<Window title="journal.log">
					<a href="/dysphoricals/" class="back-link">← back to home</a>
					{sortedEntries.length === 0 ? (
						<p class="empty-state">no entries yet</p>
					) : (
						<ul class="entry-list">
							{sortedEntries.map(entry => {
								const slug = entry.id.replace(/\.md$/, '');
								return (
									<li class="entry-row">
										<a href={`/dysphoricals/journal/${slug}`} class="entry-link">
											<span class="entry-date">{entry.data.date.toISOString().split('T')[0]}</span>
											<span class="entry-title">
												{entry.data.pinned && <span class="pin-icon">📌</span>}
												{entry.data.title}
											</span>
										</a>
									</li>
								);
							})}
						</ul>
					)}
				</Window>
			</div>
		</div>
	</body>
</html>

<style>
	.journal-container {
		padding: 48px;
		max-width: 700px;
		margin: 0 auto;
		min-height: 100vh;
	}

	.empty-state {
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.back-link {
		display: inline-block;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.8rem;
		margin-bottom: 20px;
	}

	.back-link:hover {
		color: var(--accent-lavender);
	}

	.entry-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.entry-row {
		margin: 0;
	}

	.entry-link {
		display: flex;
		gap: 16px;
		padding: 8px 12px;
		text-decoration: none;
		color: var(--text);
		font-size: 0.85rem;
		text-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
	}

	.entry-link:hover .entry-title {
		text-decoration: underline;
	}

	.entry-date {
		color: var(--text-muted);
		min-width: 100px;
		font-variant-numeric: tabular-nums;
	}

	.entry-title {
		color: var(--text);
		display: flex;
		align-items: center;
		gap: 6px;
	}

	.pin-icon {
		font-size: 0.7rem;
		color: var(--text-muted);
	}

	@media (max-width: 900px) {
		.journal-container {
			padding: 24px;
		}

		.entry-link {
			flex-direction: column;
			gap: 4px;
		}

		.entry-date {
			min-width: auto;
			font-size: 0.75rem;
		}
	}
</style>

---
interface Props {
  title: string;
  icon?: string;
}

const { title, icon = '♡' } = Astro.props;
---

<div class="window">
  <div class="window-titlebar">
    <span class="window-icon">{icon}</span>
    <span class="window-title">{title}</span>
    <div class="window-dots">
      <span class="dot"></span>
      <span class="dot"></span>
      <span class="dot"></span>
    </div>
  </div>
  <div class="window-body">
    <slot />
  </div>
</div>

<style>
  .window {
    border: 1px solid rgba(184, 160, 232, 0.4);
    border-radius: 6px;
    overflow: hidden;
  }

  .window-titlebar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    background: rgba(40, 35, 50, 0.85);
    border-bottom: 1px solid rgba(184, 160, 232, 0.3);
    user-select: none;
  }

  .window-icon {
    font-size: 0.7rem;
    color: var(--accent-pink);
    line-height: 1;
  }

  .window-title {
    font-size: 0.65rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.02em;
    flex: 1;
  }

  .window-dots {
    display: flex;
    gap: 4px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: transparent;
    border: 1px solid rgba(184, 160, 232, 0.4);
  }

  .window-body {
    padding: 20px;
    background: rgba(40, 35, 50, 0.7);
  }
</style>
